{
  "manifest_version": 3,
  "name": "AiSolotl Collector",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://www.facebook.com/messages/*",
    "http://127.0.0.1:8000/*"
  ],
  "background":{
    "service_worker":"background/background.js"
  },
  "action":{
    "default_popup":"popup/popup.html"
  }
}