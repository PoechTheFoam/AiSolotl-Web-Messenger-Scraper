{
  "manifest_version": 3,
  "name": "AiSolotl Collector",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://www.facebook.com/messages/*",
    "http://127.0.0.1:8000/*"
  ],
  "background":{
    "service_worker":"background.js"
  },
  "content_scripts":[{
    "matches":["https://www.messenger.com/*",
    "https://www.facebook.com/messages/*"],
    "js":["content.js"],
    "run_at": "document_idle"
  }]
}